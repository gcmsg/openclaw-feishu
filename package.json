{
  "name": "openclaw-feishu",
  "version": "1.0.0",
  "description": "飞书通道插件 - 支持消息、云文档、云空间 | Feishu channel plugin with docs & drive support",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "openclaw": {
    "extensions": ["./index.ts"]
  },
  "clawdbot": {
    "extensions": ["./index.ts"]
  },
  "keywords": [
    "openclaw",
    "clawdbot",
    "moltbot",
    "feishu",
    "lark",
    "bot",
    "document",
    "drive",
    "plugin"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gcmsg/openclaw-feishu"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "openclaw": "*",
    "clawdbot": "*"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    },
    "clawdbot": {
      "optional": true
    }
  }
}
